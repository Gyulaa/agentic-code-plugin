#!/bin/sh
# Runs the project check on the staged files before every commit.
# Enable once per clone: git config core.hooksPath .githooks
# Documentation-only commits may skip it: SKIP_CHECK=1 git commit ...
[ "${SKIP_CHECK:-}" = "1" ] && { echo "pre-commit: check skipped (SKIP_CHECK=1)"; exit 0; }
ROOT="$(git rev-parse --show-toplevel)"
exec "$ROOT/scripts/check.sh" --staged
